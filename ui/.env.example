# Copy this file to ui/.env and fill in your key(s).
# You only need ONE key — Groq is free and recommended.

# Option 1: Groq (free) — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Option 2: Google Gemini (free) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Option 3: OpenAI (paid) — https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
